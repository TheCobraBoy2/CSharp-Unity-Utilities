{
  "name": "csharp-unity-utilities",
  "displayName": "C# Unity Utilities",
  "publisher": "vorrikz",
  "version": "1.0.46",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheCobraBoy2/CSharp-Unity-Utilities"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "unityUtilities.newMonoBehaviour",
        "title": "New C# MonoBehaviour Script"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "unityUtilities.newMonoBehaviour",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "C# Unity Utilities",
      "properties": {
        "csharpUnityUtilities.template": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "// -----------------------------------------",
            "// Script: {{CLASSNAME}}",
            "// Namespace: {{NAMESPACE}}",
            "// C# Unity Utils Version: {{VERSION}}",
            "// Created: {{DATE}}",
            "// -----------------------------------------",
            "",
            "using UnityEngine;",
            "",
            "namespace {{NAMESPACE}} {",
            "    public class {{CLASSNAME}} : MonoBehaviour",
            "    {",
            "        void Start() { }",
            "        ",
            "        void Update() { }",
            "    }",
            "}"
          ],
          "description": "Template for generating new MonoBehaviour scripts."
        }
      }
    }
  },
  "scripts": {
    "build": "pwsh ./build.ps1"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "@types/node": "^20.6.2",
    "@types/vscode": "^1.80.0",
    "auto-changelog": "^2.2.0"
  }
}
